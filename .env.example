# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# HYBRID DEPLOYMENT ENDPOINT CONFIGURATION:
# Set this variable if you want the Cloudflare static client to automatically 
# connect to a specific central server URL by default.
# Leave blank to fallback to LocalStorage/local network sync configuration inside the app.
# Example for LAN/Local server: VITE_API_URL="http://192.168.1.10:3000"
# Example for Cloud/VPS server: VITE_API_URL="https://api.myposstore.com"
VITE_API_URL=""
